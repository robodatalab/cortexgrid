# Values needed to start the head that the setup can't work out on its own.
# Copy to .env.head and fill in. Head setup generates or looks up everything
# else and publishes it, together with these, to the head's secrets store.

# GitHub token with read:packages. Pulls our private images from ghcr.io and
# serves as Argo CD's repo credential.
GH_TOKEN=

# Tailscale OAuth client for the in-cluster Tailscale operator, which exposes
# cluster services on the tailnet.
TAILSCALE_OPERATOR_CLIENT_ID=
TAILSCALE_OPERATOR_CLIENT_SECRET=

# GitHub App for the in-cluster Actions runners that run the integration tests.
GH_APP_ID=
GH_APP_INSTALLATION_ID=
# PEM spans multiple lines: wrap the whole value in double quotes.
GH_APP_PRIVATE_KEY=

# On-prem profile only: AWS keys of an IAM user with Route53 access to the
# robodatalab.com zone. cert-manager uses them to issue HTTPS certificates for
# the cluster's subdomains. On the AWS profile, setup reads them from
# terraform/platform/secrets outputs instead.
ROUTE53_ACCESS_KEY_ID=
ROUTE53_SECRET_ACCESS_KEY=

# AWS profile only: reusable (non-ephemeral) Tailscale auth key the EC2 head
# uses to join the tailnet during `make head-aws-apply`.
TAILSCALE_AUTH_KEY=
