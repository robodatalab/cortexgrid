# Copy to terraform.tfvars and fill in values.
# NEVER commit terraform.tfvars — it contains secrets.

# ── Website ───────────────────────────────────────────────────────────────────
aws_region   = "us-east-1"
domain_name  = "robodatalab.com"
environment  = "production"
github_repo  = "paksas/robolabwebsite"

# ── Investor auth ─────────────────────────────────────────────────────────────
admin_email  = "ptrochim@proton.me"
from_email   = "noreply@robodatalab.com"
db_name      = "robolab_auth"
db_username  = "robolab_auth"

# After the first apply, set api_gateway_domain to the value of the
# api_gateway_invoke_url output (without https://) to wire up CloudFront.
api_gateway_domain = ""

# Set these via environment variables — do NOT store in this file:
#   export TF_VAR_db_password="$(openssl rand -base64 32)"
#   export TF_VAR_jwt_secret="$(openssl rand -base64 48)"
