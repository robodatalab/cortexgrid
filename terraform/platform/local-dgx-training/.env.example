# =============================================================================
# RoboLab ML Infrastructure — Bootstrap credentials
# =============================================================================
#
# This file contains ONLY the credentials needed for containers to
# authenticate against the Configuration Management Service (AWS Secrets
# Manager today). Everything else is fetched from the CMS at runtime.
#
# First-time setup:
#   1. cd terraform/platform/secrets && terraform output dgx_user_access_key_id
#      and terraform output -raw dgx_user_secret_access_key
#   2. cp .env.example .env and paste the values below
#
# =============================================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
