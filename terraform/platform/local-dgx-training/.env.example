# =============================================================================
# RoboLab ML Infrastructure — Secrets
# =============================================================================
#
# First-time setup:
#   1. cp .env.example .env
#   2. Fill in the values below
#   3. make setup-mac   (pushes secrets to AWS, configures your Mac)
#
# After initial setup, secrets live in AWS Secrets Manager. To refresh:
#   bash scripts/pull-secrets.sh
#
# =============================================================================

# Tailscale IP of the DGX Spark (run `tailscale ip -4` on the DGX)
DGX_TAILSCALE_IP=100.x.x.x

# SSH user on the DGX (defaults to your current username)
# DGX_SSH_USER=piotrtrochim

# Path to the local-dgx-training dir on the DGX (defaults to ~/robolab-infra/...)
# DGX_REPO_PATH=/home/piotrtrochim/robolab-infra/terraform/platform/local-dgx-training

# --- PostgreSQL (MLflow backend store) ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=
POSTGRES_DB=mlflow

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# --- Storage ---
ARTIFACT_STORE_ENDPOINT=http://minio:9000
ARTIFACT_STORE_BUCKET=mlflow-artifacts
ARTIFACT_STORE_ACCESS_KEY=minioadmin
ARTIFACT_STORE_SECRET_KEY=

# --- MLflow ---
MLFLOW_TRACKING_URI=http://${DGX_TAILSCALE_IP}:5000
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts/

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Ray GCS (Redis) ---
RAY_REDIS_ADDRESS=redis:6379
